#!/bin/sh
# Refuse accidental direct pushes to main. GitHub branch protection is the
# authoritative control and will also apply to pushes made without this hook.
while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are disabled. Open a pull request instead." >&2
    exit 1
  fi
done
