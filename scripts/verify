#!/bin/sh
set -eu

python3 -m compileall -q custom_components tests
python3 -m unittest discover -s tests -v

if [ -x .venv/bin/ruff ]; then
  ruff_command=.venv/bin/ruff
elif command -v ruff >/dev/null 2>&1; then
  ruff_command=ruff
else
  echo "Ruff is required. Create .venv and install it: python3 -m venv .venv && .venv/bin/python -m pip install ruff" >&2
  exit 127
fi

"$ruff_command" check custom_components tests
"$ruff_command" format --check custom_components tests
